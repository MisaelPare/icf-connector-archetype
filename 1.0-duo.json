          "label": "Token Endpoint",
          "model": "tokenEndpoint",
          "show": "authenticationMethodOAUTH",
          "type": "string"
        }
      ],
      [
        {
          "description": "Secure client identifier for OAuth2.",
          "label": "Client Id",
          "model": "clientId",
          "show": "authenticationMethodOAUTH",
          "type": "string"
        }
      ],
      [
        {
          "autocomplete": "new-password",
